---
import Icon from './Icon.astro';
import { site } from '../data/site';
const { title = 'Позвоните или напишите' } = Astro.props;
---
<div class="callcard">
  <h2>{title}</h2>
  <a class="callcard-phone" href={`tel:${site.phone}`} data-goal="click_phone">{site.phoneDisplay}</a>
  <p>{site.hours}. Опишите, что с часами, или пришлите фото в WhatsApp, и я сориентирую по причине и цене.</p>
  <div class="btns">
    <a class="btn btn-primary" href={`tel:${site.phone}`} data-goal="click_phone"><Icon name="phone" />Позвонить</a>
    <a class="btn btn-line" href={site.whatsapp} data-goal="click_whatsapp" target="_blank" rel="noopener"><Icon name="whatsapp" />Написать в WhatsApp</a>
  </div>
</div>
