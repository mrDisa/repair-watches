---
import Base from '../layouts/Base.astro';
import ContactButtons from '../components/ContactButtons.astro';
---
<Base title="Страница не найдена — ремонт часов в Ставрополе" description="Такой страницы нет. Перейдите на главную или к списку услуг по ремонту настенных часов в Ставрополе." noindex>
  <section class="section notfound">
    <div class="wrap">
      <h1>Страница не найдена</h1>
      <p>Возможно, ссылка устарела. Перейдите на <a href="/">главную</a> или посмотрите <a href="/uslugi/">услуги</a>.</p>
      <div style="display:flex;justify-content:center"><ContactButtons /></div>
    </div>
  </section>
</Base>
